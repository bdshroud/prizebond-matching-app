# Environment Configuration
NODE_ENV=development
PORT=5000

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/prizebond_platform
# For MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/prizebond_platform?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_for_security
JWT_EXPIRES_IN=7d

# Resend Email Configuration (Optional for development, mock logger used if missing)
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=PrizeBond Bangladesh <notifications@prizebond.gov.bd>

# Client URL (for CORS and verification links)
CLIENT_URL=http://localhost:3000

# Admin Seed Account (Auto-created on first boot if no admin exists)
ADMIN_NAME=Platform Administrator
ADMIN_EMAIL=admin@prizebond.gov.bd
ADMIN_PASSWORD=AdminSecurePass2025!

# Better Auth & Social Providers
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
