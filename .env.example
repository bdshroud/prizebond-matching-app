# ==============================================================================
# Bangladesh Prize Bond Monitoring & Automated Winner Notification Web Platform
# Environment Configuration Template (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (Node.js / Express / Mongoose)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/prizebond_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/prizebond_matching_db

# JSON Web Token (JWT) Secrets
# Generate secure secrets with: openssl rand -base64 32
JWT_SECRET=super_secret_jwt_signing_key_replace_in_production_min32chars
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (Comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Transactional Email Provider (Resend)
# Leave blank or "mock" in local development to log emails to console
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM="Bangladesh Prize Bond Monitor <notifications@prizebond-bd.com>"

# Scheduled Background Worker / Cron
ENABLE_CRON=true
CRON_SCHEDULE="0 * * * *"
ADMIN_CRON_SECRET=replace_with_secure_internal_worker_secret

# Initial Seed Admin Account (Created automatically on first start if not existing)
INITIAL_ADMIN_EMAIL=admin@prizebond.gov.bd
INITIAL_ADMIN_PASSWORD=AdminPass123!
INITIAL_ADMIN_NAME="System Administrator"

# ------------------------------------------------------------------------------
# Better Auth & Social Login Providers
# ------------------------------------------------------------------------------
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# Frontend Configuration (Next.js 15 App Router)
# ------------------------------------------------------------------------------
# In local development, the Next.js rewrite or direct URL targets the backend
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_APP_NAME="Bangladesh Prize Bond Monitor"
NEXT_PUBLIC_APP_URL=http://localhost:3000
