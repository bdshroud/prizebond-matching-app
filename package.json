{
  "name": "prizebond-platform",
  "version": "2.0.0",
  "description": "Bangladesh Prize Bond Monitoring & Automated Winner Notification Web Platform",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm --prefix backend run build && npm --prefix frontend run build",
    "start:backend": "npm --prefix backend start",
    "start:frontend": "npm --prefix frontend start",
    "test:backend": "npm --prefix backend test",
    "install:backend": "npm --prefix backend install",
    "install:frontend": "npm --prefix frontend install"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
